# Local gliquid wheels.
src/wheels/

# Byte-compiled artifacts.
__pycache__/
*.py[cod]

# The app tests and their dependencies; the image installs requirements.txt only.
src/tests/
src/requirements-dev.txt
.pytest_cache/

# Loose matrix sheets; the app serves them from gliqviz/matrix_shards/.
src/app/gliqviz/matrix_assets/

# SQLite sidecars of the cache store, created whenever it is opened.
src/app/gliqviz/gliquid_cache.sqlite-shm
src/app/gliqviz/gliquid_cache.sqlite-wal
